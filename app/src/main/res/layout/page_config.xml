<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F3F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="配置"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按屏幕保存：分辨率、刷新率、DPI、方向、音频输出"
            android:textColor="#607D8B"
            android:textSize="12sp" />

        <!-- 当前屏幕 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前屏幕"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScreenLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="未检测到外接屏"
                android:textColor="#263238"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvScreenId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#90A4AE"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvAudioState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="外接屏音频：未知"
                android:textColor="#455A64"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAudioSwitcher"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="切换音频输出（系统选择器）"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 该屏参数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="屏幕参数（按屏幕保存）"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="分辨率 / 刷新率"
                android:textColor="#455A64"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spExternalMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="DPI（density）"
                android:textColor="#455A64"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spDensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="屏幕方向"
                android:textColor="#455A64"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spRotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="音频输出"
                android:textColor="#455A64"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spAudioOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swLockLandscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="展开后锁定横屏"
                android:textColor="#263238"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swUnlockKeyguard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="展开后解除锁屏（锁屏会强制竖屏）"
                android:textColor="#263238"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swImmersive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="展开后沉浸全屏"
                android:textColor="#263238"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="保存"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnApplyProfile"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:text="应用"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnResetProfile"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:text="重置"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="提示：这台 ROM 会忽略外接屏的模式切换，DPI 是真正生效的；分辨率改不动属于系统限制。"
                android:textColor="#90A4AE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
